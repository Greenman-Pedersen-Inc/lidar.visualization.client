# Required paths on the processing server.
INPUT_DIR=/srv/njdot/copc
WORK_DIR=/srv/njdot/terrain-work

# Generation-only is the safe default. The generated terrain directory can be
# uploaded separately to the prefix shown below.
UPLOAD=false
S3_URI=s3://njdot-lidar-streaming-test/Baker-2021-Route9-North-middle10-20260917-101430/terrain
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Set this when the public URL differs from the standard S3 virtual-host URL,
# for example when CloudFront is in front of the bucket.
# PUBLIC_BASE_URL=https://cdn.example.gov/Baker-2021-Route9-North-middle10-20260917-101430/terrain

# Processing containers. Override these to pin internally mirrored images.
PDAL_IMAGE=ghcr.io/pdal/pdal:2.10.2
CTB_IMAGE=ghcr.io/tum-gis/ctb-quantized-mesh:latest
PULL_IMAGES=true

# The supplied Route 9 COPCs use New Jersey State Plane US survey feet.
# Z_SCALE converts the source elevations from US survey feet to meters.
SOURCE_HORIZONTAL_CRS=EPSG:3424
SOURCE_COMPOUND_CRS=EPSG:3424+5703
TARGET_3D_CRS=EPSG:4979
APPLY_VERTICAL_TRANSFORM=true
Z_SCALE=0.3048006096012192

# ASPRS ground is class 2. Use 2,17 to include bridge decks.
GROUND_CLASSES=2

# Set true only when the input does not already contain usable ground classes.
# These SMRF distances are expressed in source horizontal units (US feet here).
CLASSIFY_GROUND=false
SMRF_CELL=3.280833333
SMRF_WINDOW=59.055
SMRF_THRESHOLD=1.640416667
SMRF_SLOPE=0.15

# DEM resolution, search radius, and interpolation window are in source XY units.
DEM_RESOLUTION=1.0
DEM_RADIUS=1.5
DEM_WINDOW_SIZE=5
FILL_DISTANCE=500
FILL_SMOOTH_ITERATIONS=2

# Uploads are non-destructive by default. Enabling this removes old S3 objects
# under S3_URI that are absent from the newly generated tileset.
DELETE_STALE_S3_OBJECTS=false
TERRAIN_CACHE_CONTROL=public,max-age=31536000,immutable
